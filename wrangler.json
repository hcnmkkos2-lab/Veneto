{
  "name": "veneto",
  "main": "src/admin-wrapper.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".github/**",
      "migrations/**",
      "src/**",
      "*.json",
      "*.md",
      "*.yml",
      "*.yaml",
      "*.lock",
      "*.toml",
      "*.sqlite",
      "*.db",
      "server.js",
      "railway.json",
      "render.yaml",
      ".node-version"
    ],
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/", "/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veneto-db",
      "database_id": "557365ae-99db-4791-ba5b-3fb348fcaa57",
      "migrations_dir": "migrations"
    }
  ]
}
