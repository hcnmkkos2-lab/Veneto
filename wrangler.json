{
  "name": "veneto",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "include": ["/index.html", "/admin.html", "/checkout.js"],
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/", "/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veneto-db",
      "database_id": "557365ae-99db-4791-ba5b-3fb348fcaa57",
      "migrations_dir": "migrations"
    }
  ]
}
